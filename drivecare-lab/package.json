{
  "name": "drivecare-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"tsx server/index.ts\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
